# Environment & secrets
.env
.env.*
.secret_key

# Downloads & generated data
db/*
!db/.gitkeep
downloads/*
!downloads/.gitkeep
# 앱은 항상 downloads/ 를 사용한다. download/(단수)는 구버전·수동 조작으로 생긴 잔재.
download/

# Logs
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.venv-*/
venv/
*.egg-info/
dist/
build/
.uv/

# Node
node_modules/
*.lock
!package-lock.json
!uv.lock

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# OMC artifacts
.omc/
!.omc/skills/

# Planning artifacts
plan.md
plan-*.md
research.md
.omx/
# Local HTTPS certificates
certs/*
!certs/.gitkeep
